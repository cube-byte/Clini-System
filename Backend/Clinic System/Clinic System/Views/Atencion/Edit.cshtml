@model Clinic_System.Models.Atencion
@{
    ViewData["Title"] = "Editar Atención";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0 rounded-4">
                <div class="card-header bg-warning py-3">
                    <h3 class="mb-0 fw-bold text-dark">Editar Atención</h3>
                    <small class="text-dark">Modifique los datos necesarios</small>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="IdAtencion" />
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="FechaAtencion" class="form-label fw-semibold"></label>
                                <input asp-for="FechaAtencion" type="datetime-local" class="form-control" />
                                <span asp-validation-for="FechaAtencion" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Observacion" class="form-label fw-semibold"></label>
                                <input asp-for="Observacion" class="form-control" />
                                <span asp-validation-for="Observacion" class="text-danger small"></span>
                            </div>
                            <div class="col-md-12">
                                <label asp-for="IdCita" class="form-label fw-semibold"></label>
                                <select asp-for="IdCita"
                                        class="form-select"
                                        asp-items="@(ViewBag.Citas as SelectList)">
                                    <option value="">-- Seleccione cita --</option>
                                </select>
                                <span asp-validation-for="IdCita" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-primary text-dark px-4 fw-semibold">
                                Guardar Cambios
                            </button>
                            <a asp-action="Index" class="btn btn-danger px-4">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}