@model Clinic_System.Models.Atencion
@{
    ViewData["Title"] = "Detalle de Atención";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <!-- Card principal -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="card-header border-0 py-4 px-4" style="background: linear-gradient(135deg, #1a73e8, #0d47a1);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-white bg-opacity-25 rounded-circle p-2">
                            <i class="bi bi-clipboard2-pulse-fill fs-4 text-white"></i>
                        </div>
                        <div>
                            <h4 class="text-white mb-0 fw-bold">Detalle de Atención</h4>
                            <small class="text-white-50">Información del registro médico</small>
                        </div>
                    </div>
                </div>

                <!-- Body -->
                <div class="card-body px-4 py-4">

                    <!-- Fecha -->
                    <div class="d-flex align-items-center p-3 mb-3 rounded-3" style="background-color: #f0f4ff;">
                        <div class="me-3 text-primary">
                            <i class="bi bi-calendar-check-fill fs-4"></i>
                        </div>
                        <div>
                            <small class="text-muted fw-semibold text-uppercase" style="font-size: 0.7rem; letter-spacing: 1px;">Fecha de Atención</small>
                            <p class="mb-0 fw-bold text-dark">@Html.DisplayFor(model => model.FechaAtencion)</p>
                        </div>
                    </div>

                    <!-- Observación -->
                    <div class="d-flex align-items-start p-3 mb-3 rounded-3" style="background-color: #f0f4ff;">
                        <div class="me-3 text-primary">
                            <i class="bi bi-journal-text fs-4"></i>
                        </div>
                        <div>
                            <small class="text-muted fw-semibold text-uppercase" style="font-size: 0.7rem; letter-spacing: 1px;">Observación</small>
                            <p class="mb-0 fw-bold text-dark">@Html.DisplayFor(model => model.Observacion)</p>
                        </div>
                    </div>

                    <!-- Cita -->
                    <div class="d-flex align-items-center p-3 rounded-3" style="background-color: #f0f4ff;">
                        <div class="me-3 text-primary">
                            <i class="bi bi-ticket-detailed-fill fs-4"></i>
                        </div>
                        <div>
                            <small class="text-muted fw-semibold text-uppercase" style="font-size: 0.7rem; letter-spacing: 1px;">Código de Cita</small>
                            <p class="mb-0 fw-bold text-dark">@Html.DisplayFor(model => model.Cita.CodigoCita)</p>
                        </div>
                    </div>

                </div>

                <!-- Footer -->
                <div class="card-footer border-0 bg-white px-4 py-3 d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model?.IdAtencion" class="btn btn-primary rounded-3 px-4 fw-semibold">
                        <i class="bi bi-pencil-fill me-1"></i> Editar
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4 fw-semibold">
                        <i class="bi bi-arrow-left me-1"></i> Volver
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>