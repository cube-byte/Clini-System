@model Clinic_System.Models.Medico

@{
    ViewData["Title"] = "Editar Médico";
}

<div class="container mt-4">

    <!-- HEADER -->
    <div class="bg-primary text-white p-3 rounded mb-3 text-center">
        <h4 class="mb-0">EDITAR MÉDICO</h4>
    </div>

    <form asp-action="Edit">

        <input type="hidden" asp-for="IdMedico" />

        <table class="table table-bordered table-hover">

            <tbody>

                <tr>
                    <th>Nombre</th>
                    <td>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </td>
                </tr>

                <tr>
                    <th>Apellido</th>
                    <td>
                        <input asp-for="Apellido" class="form-control" />
                        <span asp-validation-for="Apellido" class="text-danger"></span>
                    </td>
                </tr>

                <tr>
                    <th>DNI</th>
                    <td>
                        <input asp-for="DNI" class="form-control" />
                        <span asp-validation-for="DNI" class="text-danger"></span>
                    </td>
                </tr>

                <tr>
                    <th>Teléfono</th>
                    <td>
                        <input asp-for="Telefono" class="form-control" />
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                    </td>
                </tr>

                <tr>
                    <th>Correo</th>
                    <td>
                        <input asp-for="Correo" class="form-control" />
                        <span asp-validation-for="Correo" class="text-danger"></span>
                    </td>
                </tr>

                <tr>
                    <th>Especialidad</th>
                    <td>
                        <select asp-for="IdEspecialidad"
                                class="form-control"
                                asp-items="ViewBag.IdEspecialidad">
                        </select>
                        <span asp-validation-for="IdEspecialidad" class="text-danger"></span>
                    </td>
                </tr>

            </tbody>

        </table>

        <div class="mt-4 d-flex gap-2">
            <input type="submit" value="Guardar Cambios"
                   class="btn btn-primary text-dark px-4 fw-semibold" />

            <a asp-action="Index"
               class="btn btn-danger px-4 text-dark text-decoration-none">
                Volver
            </a>
        </div>

    </form>
</div>