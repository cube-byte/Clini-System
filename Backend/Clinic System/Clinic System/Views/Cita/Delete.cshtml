@model Clinic_System.Models.Cita

@{
    ViewData["Title"] = "Eliminar Cita";
}

<div class="container mt-5">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow border-0 rounded-4">

                <!-- HEADER -->
                <div class="card-header bg-danger text-white py-3">
                    <h3 class="mb-0 fw-bold">Eliminar Cita</h3>
                    <small>Esta acción no se puede deshacer</small>
                </div>

                <!-- BODY -->
                <div class="card-body p-4">

                    <div class="alert alert-warning">
                        ¿Seguro que deseas eliminar esta cita?
                    </div>

                    <dl class="row mb-4">

                        <dt class="col-sm-4 fw-bold">Código</dt>
                        <dd class="col-sm-8">@Model.CodigoCita</dd>

                        <dt class="col-sm-4 fw-bold">Fecha</dt>
                        <dd class="col-sm-8">@Model.FechaCita.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-4 fw-bold">Descripción</dt>
                        <dd class="col-sm-8">@Model.Descripcion</dd>

                        <dt class="col-sm-4 fw-bold">Estado</dt>
                        <dd class="col-sm-8">@Model.Estado</dd>

                        <dt class="col-sm-4 fw-bold">Paciente</dt>
                        <dd class="col-sm-8">@Model.Paciente?.Nombre</dd>

                        <dt class="col-sm-4 fw-bold">Médico</dt>
                        <dd class="col-sm-8">@Model.Medico?.Nombre</dd>

                        <dt class="col-sm-4 fw-bold">Tipo de Cita</dt>
                        <dd class="col-sm-8">@Model.TipoCita?.NombreTipoCita</dd>

                    </dl>

                    <form asp-action="Delete">

                        <input type="hidden" asp-for="IdCita" />

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-danger px-4 fw-semibold">
                                Eliminar
                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary px-4">
                                Volver a la lista
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>

</div>