@model Clinic_System.Models.Cita

@{
    ViewData["Title"] = "Editar Cita";
}

<div class="container mt-5">

    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="card shadow border-0 rounded-4 overflow-hidden">

                <!-- HEADER -->
                <div class="card-header bg-warning py-3">
                    <h3 class="mb-0 fw-bold text-dark">Editar Cita</h3>
                    <small class="text-dark">Modifique los datos necesarios</small>
                </div>

                <!-- BODY -->
                <div class="card-body p-4">

                    <form asp-action="Edit">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <input type="hidden" asp-for="IdCita" />

                        <div class="row g-4">

                            <div class="col-md-4">
                                <label asp-for="CodigoCita" class="form-label fw-semibold"></label>
                                <input asp-for="CodigoCita" class="form-control" />
                                <span asp-validation-for="CodigoCita" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="FechaCita" class="form-label fw-semibold"></label>
                                <input asp-for="FechaCita" type="datetime-local" class="form-control" />
                                <span asp-validation-for="FechaCita" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Estado" class="form-label fw-semibold"></label>
                                <input asp-for="Estado" class="form-control" />
                                <span asp-validation-for="Estado" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Descripcion" class="form-label fw-semibold"></label>
                                <input asp-for="Descripcion" class="form-control" />
                                <span asp-validation-for="Descripcion" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="IdPaciente" class="form-label fw-semibold"></label>
                                <select asp-for="IdPaciente"
                                        class="form-select"
                                        asp-items="ViewBag.IdPaciente">
                                </select>
                                <span asp-validation-for="IdPaciente" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="IdMedico" class="form-label fw-semibold"></label>
                                <select asp-for="IdMedico"
                                        class="form-select"
                                        asp-items="ViewBag.IdMedico">
                                </select>
                                <span asp-validation-for="IdMedico" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="IdTipoCita" class="form-label fw-semibold"></label>
                                <select asp-for="IdTipoCita"
                                        class="form-select"
                                        asp-items="ViewBag.IdTipoCita">
                                </select>
                                <span asp-validation-for="IdTipoCita" class="text-danger small"></span>
                            </div>

                        </div>

                        <!-- BOTONES -->
                        <div class="mt-4 justify-content-end gap-2">
                            <button type="submit"
                                    class="btn btn-primary text-dark px-4 fw-semibold">
                                Guardar Cambios
                            </button>

                            <a asp-action="Index"
                               class="btn btn-danger px-4">
                                Cancelar
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}