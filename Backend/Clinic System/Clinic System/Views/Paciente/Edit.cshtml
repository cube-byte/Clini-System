@model Clinic_System.Models.Paciente

@{
    ViewData["Title"] = "Editar Paciente";
}

<div class="container mt-5">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow border-0 rounded-4">

                <div class="card-header bg-warning py-3">
                    <h3 class="mb-0 fw-bold text-dark">Editar Paciente</h3>
                    <small class="text-dark">Actualice la información del paciente</small>
                </div>

                <div class="card-body p-4">

                    <form asp-action="Edit">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <input type="hidden" asp-for="IdPaciente" />

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label asp-for="Nombre" class="form-label fw-semibold"></label>
                                <input asp-for="Nombre" class="form-control" />
                                <span asp-validation-for="Nombre" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Apellido" class="form-label fw-semibold"></label>
                                <input asp-for="Apellido" class="form-control" />
                                <span asp-validation-for="Apellido" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="DNI" class="form-label fw-semibold"></label>
                                <input asp-for="DNI" class="form-control" />
                                <span asp-validation-for="DNI" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="FechaNacimiento" class="form-label fw-semibold"></label>
                                <input asp-for="FechaNacimiento" type="date" class="form-control" />
                                <span asp-validation-for="FechaNacimiento" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Correo" class="form-label fw-semibold"></label>
                                <input asp-for="Correo" class="form-control" />
                                <span asp-validation-for="Correo" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Telefono" class="form-label fw-semibold"></label>
                                <input asp-for="Telefono" class="form-control" />
                                <span asp-validation-for="Telefono" class="text-danger small"></span>
                            </div>

                        </div>

                        <div class="mt-4 d-flex gap-2">
                            <input type="submit" value="Guardar Cambios"
                                   class="btn btn-primary text-dark px-4 fw-semibold" />

                            <a asp-action="Index"
                               class="btn btn-danger px-4 text-dark text-decoration-none">
                                Volver
                            </a>
                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}